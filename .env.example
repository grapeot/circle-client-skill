# Import a real browser request with `circle-client configure` instead of editing these values.
CIRCLE_CLIENT_NOTIFICATIONS_URL=https://community.example.com/internal_api/notifications
CIRCLE_CLIENT_COUNT_URL=https://community.example.com/internal_api/notifications/new_notifications_count?community_id=12345
CIRCLE_CLIENT_RESET_COUNT_URL=https://community.example.com/internal_api/notifications/mark_all_as_read
CIRCLE_CLIENT_AUTHORIZATION=Bearer replace-with-your-current-browser-jwt
CIRCLE_CLIENT_COOKIE=replace-with-your-current-browser-cookie
CIRCLE_CLIENT_USER_AGENT=Mozilla/5.0 replace-with-your-browser-user-agent
CIRCLE_CLIENT_REFERER=https://community.example.com/
CIRCLE_CLIENT_FRONTEND_VERSION=replace-with-current-frontend-version
CIRCLE_CLIENT_CSRF_TOKEN=replace-with-current-csrf-token
CIRCLE_CLIENT_ORIGIN=https://community.example.com
